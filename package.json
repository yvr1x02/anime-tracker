{
  "name": "anime-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "codegen:schema": "node scripts/fetch-schema.mjs",
    "codegen": "graphql-codegen",
    "predev": "npm run codegen",
    "prebuild": "npm run codegen",
    "pretypecheck": "npm run codegen",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "graphql": "16.15.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "22.x"
  }
}
