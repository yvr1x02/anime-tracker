# Copia in .env.local. Variabili lette solo dal server.

# Profilo AniList pubblico usato dalla modalità demo di "La mia lista" e "Statistiche" (ADR-0004). Non è un segreto.
ANILIST_DEMO_USERNAME=yvr1x0202

# Login con AniList (ADR-0004). Valori dell'applicazione AniList di sviluppo, da https://anilist.co/settings/developer.
# Il secret resta solo qui, in .env.local (escluso da git); controllo: npm run check:secret. Senza questi valori il login è spento.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Indirizzi di AniList, solo per i test e2e, che li puntano a un finto AniList (e2e/fake-anilist.mjs).
# Vuoti: https://graphql.anilist.co e https://anilist.co/api/v2/oauth. Su Vercel sono ammessi solo questi.
# ANILIST_API_URL=
# ANILIST_OAUTH_URL=
